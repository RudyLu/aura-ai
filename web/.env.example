# Google Cloud project that hosts Firestore, the photo bucket and Vertex AI.
# Leave unset for local development: data goes to web/.data/ and Aura uses preset replies.
GOOGLE_CLOUD_PROJECT=your-project-id
# Vertex AI location for Gemini ("global" or a region such as us-central1).
GOOGLE_CLOUD_LOCATION=global
# Gemini model on Vertex AI. Check it is available in your project/location.
GEMINI_MODEL=gemini-2.5-flash
# Cloud Storage bucket for uploaded food photos.
PHOTO_BUCKET=your-project-id-aura-photos
# "cloud" uses Firestore + Cloud Storage; "file" uses web/.data/. Cloud Run defaults to cloud.
STORAGE=file
# Optional: Firestore database id (default "(default)").
# FIRESTORE_DATABASE=(default)
# Optional: Gemini calls allowed per visitor session per hour (default 60).
# AI_CALLS_PER_HOUR=60
# Optional: set to 1 to turn Gemini off even when a project is set.
# GEMINI_DISABLED=1
